{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["jest"],
    "noEmit": true,
    // Typecheck against core's sources so edits there show up without building it. The build
    // (tsconfig.build.json) resets this and uses the built package, like users do.
    "paths": { "@upwell/core": ["../core/src/index.ts"] }
  },
  "include": ["src"]
}
