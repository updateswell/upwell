{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/upwell/schemas/releases.schema.json",
  "title": "Upwell releases",
  "description": "Describes every OTA release, for in-app \"What's new\" and App Review notes.",
  "type": "object",
  "required": ["schemaVersion", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platforms", "runtimeVersion", "kind", "notes", "publishedAt"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "OTA update id or update group id."
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["ios", "android"] }
          },
          "runtimeVersion": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["fix", "content", "feature"],
            "description": "fix: bug fixes. content: copy, images, config. feature: new functionality (should go through review)."
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "User-facing description of what changed. Be specific."
          },
          "publishedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
          },
          "bundleHash": {
            "type": "string",
            "pattern": "^sha256-.+",
            "description": "Reserved for the signed release log."
          }
        }
      }
    }
  }
}
